# ─────────────────────────────────────────────────────────────────────────────
# Cinema Plus – environment variable template
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────


# ── MongoDB ───────────────────────────────────────────────────────────────────

# Root admin account (used only by mongo-init.sh on first boot)
MONGO_ROOT_USER=cinemaroot
MONGO_ROOT_PASSWORD=CHANGE_ME_root_password

# Application database name
MONGO_DB_NAME=cinemadb

# Least-privilege app account created by mongo-init.sh
# This is what the Express server connects with (not the root account)
MONGO_APP_USER=admin
MONGO_APP_PASSWORD=admin


# ── Email (Gmail) ─────────────────────────────────────────────────────────────
# Use a Gmail App Password, NOT your regular account password.
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_address@gmail.com
GMAIL_PASSWORD=CHANGE_ME_gmail_app_password


# ── React build-time secrets ──────────────────────────────────────────────────
# These are baked into the JS bundle during `docker compose build`.
# Changing them requires a rebuild of the frontend image.
REACT_APP_GOOGLE_CLIENT_ID=CHANGE_ME_google_client_id
REACT_APP_FACEBOOK_APP_ID=CHANGE_ME_facebook_app_id


# ── Host networking ───────────────────────────────────────────────────────────
# Port exposed on the Docker host for the Nginx frontend.
# Change to e.g. 8080 if port 80 is already in use on your machine.
HOST_PORT=80
